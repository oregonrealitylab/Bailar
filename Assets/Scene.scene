- !<Text/9aa0178e-1e02-4961-bd95-5390cc9977ea>
  PrefabRemaps:
    []
  Name: Text
  Enabled: true
  RenderOrder: 0
  StretchMode: Stretch
  VerticalAlignment: Center
  HorizontalAlignment: Center
  MeshShadowMode: None
  ShadowColor: {x: 1.000000, y: 1.000000, z: 1.000000, w: 1.000000}
  ShadowDensity: 1.000000
  Text: |-
    Bachata's side basic is
