  InputLines:
    - '// @input SceneObject occluder {"hint":"Full-screen quad parented to the camera. Hides the swap."}'
    - '// @input SceneObject overlayRoot {"hint":"Root of the loading overlay. Disabled except during a transition."}'
    - '// @input Component.RenderMeshVisual overlayVisual {"hint":"Quad carrying the loading image."}'
    - '// @input SceneObject[] screenRoots {"hint":"Every screen root in the lens. All of them are switched off once the occluder covers the view, so nothing but the loading image is on screen."}'
    - '// @input Asset.Texture loadingTexture {"hint":"Only needed if the loading image is animated, so it can be restarted on each transition. Leave empty for a still image."}'
    - '// @ui {"widget":"group_start", "label":"Placement"}'
    - '// @input float distance = 100 {"hint":"Distance the overlay rides in front of the head, cm."}'
    - '// @input vec2 size = {35,25} {"hint":"Overlay size, cm. Width then height."}'
    - '// @input float followLag = 0.35 {"hint":"Seconds for the overlay to catch up with the gaze. Higher drags more.", "widget":"slider", "min":0.05, "max":1.5, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Timing"}'
    - '// @input float occluderFadeIn = 0.45 {"hint":"Seconds for the occluder to blot out the view."}'
    - '// @input float overlayFadeIn = 0.3 {"hint":"Seconds for the loading image to fade up, once the view is covered."}'
    - '// @input float holdDuration = 2 {"hint":"Seconds the image holds at full opacity. The scene swap happens inside this window."}'
    - '// @input float fadeOutDuration = 0.5 {"hint":"Seconds for the image and occluder to clear, revealing the new screen."}'
    - '// @ui {"widget":"group_end"}'
