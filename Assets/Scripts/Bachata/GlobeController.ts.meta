  InputLines:
    - '// @input SceneObject globeRoot {"hint":"Root of the globe screen. Disabled once a region is chosen."}'
    - '// @input SceneObject globeObject {"hint":"The globe model. Markers are parented here so they turn with it."}'
    - '// @input AssignableType_1[] markers {"hint":"Markers, in order."}'
    - '// @input SceneObject[] regionPanels {"hint":"Panel each orb raises, same order as Markers."}'
    - '// @input AssignableType_2[] closeButtons {"hint":"Close button on each panel, same order as Region Panels."}'
    - '// @input float panelDepth = 45 {"hint":"How far in front of the globe, toward the viewer, every panel sits, cm."}'
    - "// @input float panelHeight {\"hint\":\"Vertical offset from the globe's centre, cm. 0 puts the panel level with it.\"}"
    - '// @ui {"widget":"group_start", "label":"Placement"}'
    - '// @input float distance = 90 {"hint":"Distance in front of the head where the globe floats, cm."}'
    - '// @input float heightOffset = -10 {"hint":"Height relative to eye level, cm. Negative sits it lower."}'
    - '// @input float globeRadius = 25 {"hint":"Radius of the globe model at scale 1, cm. Used to sit markers on the surface."}'
    - '// @input float markerLift = 1.06 {"hint":"How far above the surface the anchors sit, as a fraction of the radius.", "widget":"slider", "min":1, "max":1.6, "step":0.01}'
    - '// @input bool snapToSurface = true {"hint":"Snap anchors onto the sphere at run time. Turn off to use their authored positions exactly."}'
    - '// @ui {"widget":"group_end"}'
    - '// @input float fadeInDuration = 0.6 {"hint":"Seconds for the globe and buttons to grow to full size when the screen opens."}'
    - '// @input float riseDuration = 0.9 {"hint":"Seconds for the globe to rise from the dance floor up to its resting height. Runs alongside the growth, so the screen looks like it is lifting out of the floor the dancer just laid. 0 skips the rise and places it directly."}'
    - '// @input bool riseOvershoot = true {"hint":"Overshoot the resting height slightly and settle back, rather than easing flatly into it. Reads as the screen coming to rest instead of stopping dead."}'
    - '// @input SceneObject[] scaleInWith {"hint":"Anything else that should scale up alongside the globe — the Main Menu button, so the screen arrives as one piece rather than the globe growing into a button that was already sitting there."}'
    - "// @input SceneObject floorAnchor {\"hint\":\"Dance floor to centre the globe over. With one set, the globe keeps its usual height but sits above the floor's middle instead of wherever the dancer happened to be looking.\"}"
    - '// @input float autoSelectAfter {"hint":"Dev only: auto-press this marker index after N seconds. 0 disables."}'
    - // @input float autoSelectIndex
