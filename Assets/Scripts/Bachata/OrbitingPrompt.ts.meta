  InputLines:
    - '// @input string message = "Pick a Region" {"hint":"The words to orbit."}'
    - '// @input float copies = 2 {"hint":"How many copies to space evenly around the ring."}'
    - '// @input Asset.Font font {"hint":"3D font for the text."}'
    - '// @input Asset.Material baseMaterial {"hint":"Material cloned per character. Its base colour is overwritten per glyph."}'
    - '// @ui {"widget":"group_start", "label":"Ring"}'
    - "// @input float radius = 26 {\"hint\":\"Distance from the globe's centre out to the text, cm.\"}"
    - "// @input float height = 22 {\"hint\":\"Height above the globe's centre, cm. Raise it to sit further over the top.\"}"
    - '// @input float degreesPerCharacter = 5.5 {"hint":"Angle between one character and the next, degrees. Widen it to spread the words out."}'
    - '// @input float pitch = -20 {"hint":"Tilt of the text, degrees. Negative tips the tops of the letters outward."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Type"}'
    - // @input float textSize = 3
    - // @input float extrusionDepth = 0.4
    - '// @ui {"widget":"group_end"}'
    - '// @input float degreesPerSecond = 8 {"hint":"Orbit speed in degrees per second. Negative reverses it, 0 holds it still.", "widget":"slider", "min":-60, "max":60, "step":1}'
    - '// @ui {"widget":"group_start", "label":"Colour"}'
    - '// @input vec4 faceColor = {1,1,1,1} {"hint":"Colour of the letters. White reads cleanly against the globe.", "widget":"color"}'
    - "// @input bool useGradient {\"hint\":\"Sweep the UI's violet-to-teal gradient across the words instead of using the flat colour above. A Text3D carries one material for the whole extruded glyph, face and sides together, so this tints the letters rather than just their edges — handsome, but harder to read against the earth.\"}"
    - '// @input vec4 colorStart = {0.34,0.22,0.52,1} {"hint":"One end of the sweep.", "widget":"color"}'
    - '// @input vec4 colorMiddle = {0.26,0.36,0.5,1} {"hint":"Middle of the sweep.", "widget":"color"}'
    - '// @input vec4 colorEnd = {0.2,0.56,0.52,1} {"hint":"The far end of the sweep.", "widget":"color"}'
    - "// @input float brightness = 2.2 {\"hint\":\"Multiplies the gradient. The UI's own values are tuned for a lit panel and read dark on unlit text, so this lifts them without changing the hues.\", \"widget\":\"slider\", \"min\":0.5, \"max\":4, \"step\":0.1}"
    - '// @ui {"widget":"group_end"}'
