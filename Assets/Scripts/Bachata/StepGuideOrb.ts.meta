  InputLines:
    - '// @input Asset.RenderMesh sphereMesh {"hint":"Sphere mesh used for the orb, its glow shells and every particle."}'
    - '// @input Asset.Material baseMaterial {"hint":"Unlit material for the solid core and the swirl. Cloned per piece."}'
    - '// @input Asset.Material glowMaterial {"hint":"Material for the glow shells. Wants additive blending with depth writing off, or the shells occlude each other and the orb reads as a flat blob."}'
    - '// @ui {"widget":"group_start", "label":"Placement"}'
    - '// @input float distance = 60 {"hint":"How far in front of the dancer the orb floats, cm."}'
    - '// @input float heightOffset {"hint":"Height relative to eye level, cm. 0 is dead ahead."}'
    - '// @input float stepDistance = 18 {"hint":"How far the orb travels per step, cm."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Orb"}'
    - '// @input float coreRadius = 3 {"hint":"Radius of the solid core, cm."}'
    - '// @input float glowShells = 3 {"hint":"How many glow shells surround the core. Each is larger and fainter."}'
    - '// @input float glowSpread = 2.4 {"hint":"Scale of the outermost shell, as a multiple of the core.", "widget":"slider", "min":1.1, "max":4, "step":0.1}'
    - '// @input float glowStrength = 0.4 {"hint":"Opacity of the innermost shell. The rest fall away from it.", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Swirl"}'
    - // @input float particleCount = 26
    - "// @input float swirlRadius = 1.35 {\"hint\":\"How far the swirl sits off the core's surface, as a multiple of its radius.\", \"widget\":\"slider\", \"min\":1, \"max\":2.5, \"step\":0.05}"
    - '// @input float particleScale = 0.12 {"hint":"Particle size as a fraction of the core.", "widget":"slider", "min":0.02, "max":0.4, "step":0.01}'
    - '// @input float swirlSpeed = 0.55 {"hint":"Turns per second of the swirl.", "widget":"slider", "min":0.05, "max":3, "step":0.05}'
    - '// @input vec4 swirlColorA = {0.35,0.95,0.7,1} {"widget":"color"}'
    - '// @input vec4 swirlColorB = {0.6,0.35,0.95,1} {"widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @input vec4 idleColor = {0.24,0.78,0.62,1} {"hint":"Colour before the first step of a set is graded.", "widget":"color"}'
    - '// @ui {"widget":"group_start", "label":"Motion"}'
    - '// @input float travelFraction = 0.55 {"hint":"Share of a beat spent travelling. The rest of the beat is the hold.", "widget":"slider", "min":0.2, "max":1, "step":0.05}'
    - '// @input float overshoot = 0.9 {"hint":"How far the orb overshoots its mark before settling back. 0 is a plain glide; higher values give the burst-and-settle that reads as a step landing.", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @input float hoverAmplitude = 0.9 {"hint":"How far the orb bobs up and down, cm.", "widget":"slider", "min":0, "max":4, "step":0.1}'
    - '// @input float hoverSpeed = 0.4 {"hint":"Bobs per second.", "widget":"slider", "min":0.05, "max":2, "step":0.05}'
    - '// @input float pulseMin = 0.8 {"hint":"Smallest the orb shrinks to while breathing, as a fraction of full size.", "widget":"slider", "min":0.5, "max":1, "step":0.05}'
    - '// @input float pulseSpeed = 0.5 {"hint":"Breaths per second.", "widget":"slider", "min":0.05, "max":2, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @input float accuracyHold = 0.9 {"hint":"Seconds a graded colour is held before the orb settles back to neutral. The colour is a reaction to one step, not a running score.", "widget":"slider", "min":0.1, "max":3, "step":0.1}'
