  InputLines:
    - '// @input AssignableType_1[] exitButtons {"hint":"Every button that should leave the tutorial. One per panel that can be on screen."}'
    - '// @input SceneObject[] tutorialRoots {"hint":"Screens switched off on the way out — the trainer and the onboarding deck."}'
