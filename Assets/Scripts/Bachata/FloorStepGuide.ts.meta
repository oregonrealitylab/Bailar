  InputLines:
    - '// @input Asset.RenderMesh planeMesh {"hint":"Flat plane mesh lying in XZ, normal +Y. Used for every print and ring."}'
    - '// @input Asset.Material material {"hint":"Transparent unlit material with Base Texture and Base Color. Cloned per piece."}'
    - // @input Asset.Texture leftFootTexture
    - // @input Asset.Texture rightFootTexture
    - '// @input Asset.Texture ringTexture {"hint":"White ring, tinted at run time. Used for the on-mark ring and the landing ripples."}'
    - '// @input SceneObject floorRoot {"hint":"The dance floor plate laid at the start. Its height is the floor. Without it the floor is taken to be Eye Height below the head."}'
    - '// @ui {"widget":"group_start", "label":"Layout"}'
    - '// @input float eyeHeight = 155 {"hint":"Used when there is no floor plate: how far below the head the floor is, cm."}'
    - '// @input float floorLift = 1 {"hint":"Lift off the floor so the prints never z-fight with it, cm."}'
    - '// @input float stride = 28 {"hint":"How far one step travels, cm. The trainer accepts 15-45."}'
    - '// @input float stanceWidth = 16 {"hint":"Centre-to-centre gap between the feet when they are together, cm."}'
    - '// @input float footLength = 26 {"hint":"Length of a print, cm."}'
    - "// @input float forwardOffset {\"hint\":\"Shift the whole guide forward of the dancer's feet, cm. 0 puts the prints right under them.\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Look"}'
    - '// @input float activeAlpha = 0.9 {"hint":"Opacity of the foot that just moved, or is about to.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float restingAlpha = 0.45 {"hint":"Opacity of the foot that is standing still.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float ghostAlpha = 0.22 {"hint":"Opacity of the ghost that marks where the next move lands.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float liftHeight = 3 {"hint":"How high a foot lifts while it travels, cm."}'
    - '// @input float travelFraction = 0.55 {"hint":"Share of a beat spent travelling. Matches the orb so both land together.", "widget":"slider", "min":0.2, "max":1, "step":0.05}'
    - '// @input float rippleDuration = 0.6 {"hint":"Seconds a landing ripple takes to spread and fade."}'
    - '// @input vec4 rippleColor = {0.55,0.6,1,1} {"widget":"color"}'
    - '// @input vec4 onMarkColor = {0.35,0.7,1,1} {"hint":"On-mark ring colour while the dancer is where the pattern expects.", "widget":"color"}'
    - '// @input vec4 offMarkColor = {1,0.7,0.25,1} {"hint":"On-mark ring colour once the dancer has drifted off the pattern.", "widget":"color"}'
    - '// @input float markTolerance = 0.6 {"hint":"How far from where the pattern expects still counts as on the mark, as a share of a stride.", "widget":"slider", "min":0.2, "max":1.5, "step":0.05}'
    - "// @input float accuracyHold = 0.9 {\"hint\":\"Seconds a step's grade colour is held on the ring and the print.\"}"
    - '// @ui {"widget":"group_end"}'
